{
  "name": "@tachyon-sdk/field",
  "version": "0.1.0",
  "description": "TypeScript client for the TACHYON Field REST API",
  "author": "Quantum Box <hello@quantum-box.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-box/field-sdk.git",
    "directory": "typescript"
  },
  "keywords": [
    "tachyon",
    "tachyon-field",
    "erp",
    "openapi",
    "sdk"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/unions.test.mjs",
    "smoke": "npm run build && node --test test/smoke.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0"
  }
}
